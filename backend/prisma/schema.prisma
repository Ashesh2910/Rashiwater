generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  role          String         @default("USER") // USER or ADMIN
  zodiac        String?
  orders        Order[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
}

model Product {
  id               String   @id @default(uuid())
  name             String
  description      String
  price            Float
  category         String   // e.g., 'Zodiac Bracelets', 'Pyrite', 'Water Bottles'
  imageUrl         String
  zodiacSign       String?  // The recommended zodiac sign or 'All'
  spiritualBenefit String?
  stock            Int            @default(10)
  type             String?        // e.g., 'water', 'bracelet'
  zodiacTag        String?        // e.g., 'leo', 'aries'
  createdAt        DateTime       @default(now())
  orders           Order[]
  subscriptions    Subscription[]
  inventoryLogs    InventoryLog[]
}

model Order {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  paymentId     String?  // Razorpay payment ID
  totalAmount   Float
  status        String   @default("PENDING") // PENDING, PAID, SHIPPED
  shippingInfo  String?  // JSON string
  
  // New fields for guest checkout & direct product relation
  userName      String?
  phone         String?
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  quantity      Int      @default(1)

  createdAt     DateTime @default(now())
}

model Subscription {
  id               String   @id @default(uuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  razorpaySubId    String?
  productId        String?
  product          Product? @relation(fields: [productId], references: [id])
  status           String   @default("ACTIVE")
  nextBillingDate  DateTime?
  createdAt        DateTime @default(now())
}

model InventoryLog {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  change        Int      // e.g., -1 (sale) or +10 (restock)
  reason        String?  // e.g., 'Order placed', 'Manual restock'
  createdAt     DateTime @default(now())
}
